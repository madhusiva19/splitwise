# Copy to backend/.env and fill in. Every ${VAR} placeholder in
# src/main/resources/application.yml is listed here. Placeholders only — never commit real values.

# ---- Required ----

# Postgres JDBC URL. For Neon, use the *pooler* host and keep sslmode=require.
DB_URL=jdbc:postgresql://<your-neon-pooler-host>/<db-name>?sslmode=require
DB_USERNAME=<your-db-user>
DB_PASSWORD=<your-db-password>

# HMAC key for signing JWT access tokens. Use a long random string (at least 32 bytes),
# e.g. `openssl rand -base64 48`.
JWT_SECRET=<your-random-secret-at-least-32-bytes>

# ---- Optional (defaults shown) ----

# Comma-separated origins allowed to call the API (set to your deployed frontend URL in prod).
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Requests per window an IP may make to /api/auth/** before getting a 429.
# AUTH_RATE_LIMIT_MAX_REQUESTS=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Spring cron (sec min hour day month weekday) for the settle-up digest job. Default: daily at 09:00.
# SETTLE_UP_DIGEST_CRON=0 0 9 * * *

# Days a non-zero group balance must sit untouched before its members get a settle-up nudge.
# SETTLE_UP_DIGEST_STALE_AFTER_DAYS=3
