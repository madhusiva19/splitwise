DB_PASSWORD=your-neon-password-here
JWT_SECRET=your-random-secret-here

# Comma-separated origins allowed to call the API. Defaults to http://localhost:3000 if unset.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Requests per window an IP may make to /api/auth/** before getting a 429. Defaults shown below.
# AUTH_RATE_LIMIT_MAX_REQUESTS=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60